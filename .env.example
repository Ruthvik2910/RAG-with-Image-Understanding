# LLM
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=2

# Embeddings
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Web Search
TAVILY_API_KEY=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=Agentic-Adaptive-RAG
LANGSMITH_API_KEY=

# RAG
CHROMA_PATH=./.chroma
COLLECTION_NAME=rag-chroma
CHUNK_SIZE=250
CHUNK_OVERLAP=0
RETRIEVAL_K=4

# API
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
# Multimodal image analysis/search
VISION_MODEL=gemini-3.5-flash-lite
IMAGE_SEARCH_RESULTS=6

# Corrected API workflow (legacy config.py is preserved)
RAG_DATA_DIR=./data
UPLOAD_PDF_MAX_MB=10
UPLOAD_DOCX_MAX_MB=10
UPLOAD_TXT_MAX_MB=5
UPLOAD_MD_MAX_MB=5
UPLOAD_IMAGE_MAX_MB=10
UPLOAD_MAX_FILES=5
DOCX_MAX_EXPANDED_MB=50
FULL_DOCUMENT_PART_CHARS=8000
RAG_CONTEXT_CHARS=16000
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150
SCOPED_COLLECTION_NAME=rag-scoped-v2
WEB_SEARCH_REQUIRE_APPROVAL=false
APPROVAL_TTL_SECONDS=600
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Optional: set a random administrator key to enable explicit legacy recovery
LEGACY_IMPORT_KEY=
